{
  // Typechecks the test sources that tsconfig.json deliberately excludes.
  //
  // `tsc -p tsconfig.json` excludes the `.test.ts` / `.spec.ts` / `.test-d.ts`
  // / `.spec-d.ts` family so they never reach `dist/` and never get published.
  // That also removes them from the only program that typechecked them:
  // `vitest run` executes tests without typechecking them, and its
  // `typecheck.include` default (`*.test-d.*`) applies only under
  // `--typecheck`, which this package does not pass — so even a `*.test-d.ts`
  // type test is typechecked by nothing but this config. A type error in a
  // test file went unnoticed until it existed.
  //
  // "exclude" is restated because `extends` inherits it, and the inherited
  // value is exactly the set of files this config exists to check — leave it
  // off and the program resolves to zero test files while still exiting 0.
  // "include" is restated for the same reason.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts"],
  "exclude": []
}
