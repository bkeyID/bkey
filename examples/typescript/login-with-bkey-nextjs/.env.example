# Copy to .env.local and fill it with the output of `npm run register`.
# The client secret is shown exactly once; re-register if you lose it.

# MUST be https://id.bkey.id for production. Not auth.bkey.id or api.bkey.id:
# both answer discovery but return a document declaring
# "issuer": "https://id.bkey.id", so the mandatory OIDC issuer-equality check
# rejects them with `issuer_mismatch` before sign-in starts.
BKEY_ISSUER=https://id.bkey.id

BKEY_CLIENT_ID=
BKEY_CLIENT_SECRET=
AUTH_SECRET=

# The origin this app is served on. Used for the redirect_uri and the
# post-logout redirect, and it determines whether Auth.js prefixes its session
# cookie with `__Secure-` (which lib/bkey.ts must agree with). Register with the
# same value: `APP_URL=<this> npm run register`.
APP_URL=http://localhost:3000

# Only when not on http://localhost:3000 — e.g. testing on a phone through an
# HTTPS tunnel. Note bkey rejects non-loopback HTTP redirect URIs (RFC 8252),
# so a http://192.168.x.x LAN address will not work.
# AUTH_URL=https://your-host/api/auth
# AUTH_TRUST_HOST=true
